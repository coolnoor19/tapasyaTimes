{
  // Type-checks the app and the tests together (the main tsconfig only covers src).
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "rootDir": "..",
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false
  },
  "include": ["../src", "./**/*.ts", "../vitest.config.ts"]
}
