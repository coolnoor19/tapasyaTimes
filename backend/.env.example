NODE_ENV=development
PORT=3005
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=verify-full

# Comma-separated frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:3000
# Number of reverse proxies in front of the app (0 = none)
TRUST_PROXY=0

# Only used by `npm run db:seed` to create the first admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-min-8-chars
ADMIN_PHONE=9999999999
