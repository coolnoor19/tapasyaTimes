NODE_ENV=development
PORT=3005
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=verify-full

# Comma-separated frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:3000
# Number of reverse proxies in front of the app (0 = none)
TRUST_PROXY=0

# Secret for hashing one-time codes (min 32 chars). Generate with:
#   node -e "(require('crypto').randomBytes(32).toString('hex'))"
OTP_HMAC_SECRET=replace-with-a-long-random-string-of-32-plus-chars

# Secret that signs login (access) tokens. Different value from OTP_HMAC_SECRET.
JWT_ACCESS_SECRET=replace-with-another-long-random-string-32-plus-chars

# Email (SMTP). Leave SMTP_HOST empty in development to print emails in the terminal.
# Gmail: host smtp.gmail.com, port 465, user = your address, pass = 16-char App Password
# (Google Account > Security > 2-Step Verification > App passwords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=nooralam192001@gmail.com
SMTP_PASS=hwgs whnn  dmpb hwgb
# Optional. Defaults to "Tapasya Times <SMTP_USER>"
MAIL_FROM=

# Only used by `npm run db:seed` to create the first admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-min-8-chars
ADMIN_PHONE=9999999999

# Separate database used ONLY by `npm test`. Tests delete data, so this must NOT
# be your dev database (e.g. create a second Neon branch/database). If unset,
# database tests are skipped and only unit tests run.
TEST_DATABASE_URL=
